{
  "name": "gpu-sre-client",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --win portable",
    "android:sync": "cap sync android",
    "postinstall": "node tools/prepare-demo.mjs",
    "test:ui": "node tools/check-public-ui.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@huggingface/transformers": "^3.7.2",
    "idb": "^8.0.2",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.56.1",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "local.gpusre.copilot",
    "productName": "GPU SRE Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      }
    ]
  },
  "license": "Apache-2.0",
  "author": "haozheyu"
}
